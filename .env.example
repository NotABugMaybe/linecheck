# Copy to .env for local operation. Generate a unique secret with:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-random-secret-before-start
DATABASE_URL=sqlite:///./backend/linecheck.db
STORAGE_DIR=./backend/data/images
DEVELOPMENT_MODE=true
MAX_UPLOAD_BYTES=10000000
TOKEN_EXPIRY_MINUTES=60
